{
  "manifestVersion": 5,
  "id": "com.sinferous.premiere-mcp-bridge",
  "name": "Premiere MCP Bridge",
  "version": "0.2.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "27.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridgePanel",
      "label": { "default": "Premiere MCP Bridge" },
      "minimumSize": { "width": 260, "height": 220 },
      "preferredDockedSize": { "width": 300, "height": 360 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true
  }
}
